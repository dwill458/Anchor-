# ----------------------------------------------------------------------------
# Prisma
# ----------------------------------------------------------------------------
# All migrations are tracked — new migrations are picked up automatically.
# Never add a blanket "migrations/*" exclusion here; every migration SQL file
# must be version-controlled so that deploys and fresh clones are repeatable.

# ----------------------------------------------------------------------------
# Temporary Files
# ----------------------------------------------------------------------------
tmp/
temp/
*.tmp
.cache/
.codex-remote-attachments/
# Generated graphify output. Patterns are unanchored so they match the nested
# graphify-out/ directories too; the reports under the root graphify-out/ are
# committed deliberately and stay tracked.
**/graphify-out/cache/
**/graphify-out/.graphify_*
**/graphify-out/manifest.json
anchor/mobile/graphify-out/

# Throwaway git worktrees created inside the repo for PR review.
.pr-worktree/
.codex-pr-worktree/
.tmp-pr-*/

# ----------------------------------------------------------------------------
# Logs
# ----------------------------------------------------------------------------
logs
*.log
backend/*_backend_log.txt
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
pnpm-debug.log*

# ----------------------------------------------------------------------------
# Python
# ----------------------------------------------------------------------------
.venv/
__pycache__/
*.pyc

