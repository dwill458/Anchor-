+  'secureReadEventCount', 'secureWriteEventCount', 'fallbackCount',
+]);
+
+/** Fixed-name numeric-only release diagnostics for the isolated perf build. */
+export function perfDiag(event: string, data: Record<string, number> = {}): void {
+  if (process.env.EXPO_PUBLIC_ANCHOR_PERF_DIAGNOSTICS !== '1' || !diagnosticEvents.has(event)) return;
+  const numeric: Record<string, number> = {};
+  for (const [key, value] of Object.entries(data)) {
+    if (diagnosticFields.has(key) && Number.isFinite(value)) numeric[key] = value;
+  }
+  if (event === 'secure-read') {
+    adapterCounters.secureReadEventCount += 1;
+    adapterCounters.nativeCallCount += numeric.nativeCallCount ?? 0;
+    adapterCounters.nativeFailureCount += numeric.nativeFailureCount ?? 0;
+  } else if (event === 'secure-write') {
+    adapterCounters.secureWriteEventCount += 1;
+    adapterCounters.nativeCallCount += numeric.nativeCallCount ?? 0;
+    adapterCounters.nativeFailureCount += numeric.nativeFailureCount ?? 0;
+  } else if (event === 'storage-fallback') {
+    adapterCounters.fallbackCount += 1;
+  }
+  // eslint-disable-next-line no-console
+  console.warn('[PERF-DIAG]', JSON.stringify({ event, ...numeric }));
+}
+
+/** In-memory numeric adapter counters scoped to one explicitly started fixture run. */
+export function resetAdapterDiagnosticCounters(): void {
+  if (process.env.EXPO_PUBLIC_ANCHOR_PERF_DIAGNOSTICS !== '1') return;
+  adapterCounters.secureReadEventCount = 0;
+  adapterCounters.secureWriteEventCount = 0;
+  adapterCounters.nativeCallCount = 0;
+  adapterCounters.nativeFailureCount = 0;
+  adapterCounters.fallbackCount = 0;
+}
+
+export function getAdapterDiagnosticCounters() {
+  return { ...adapterCounters };
+}
+/** Bounded 16 ms loop-gap sampling, aggregated once per 10 seconds. */
+export function startDiagnosticEventLoopHistogram(): () => void {
+  if (process.env.EXPO_PUBLIC_ANCHOR_PERF_DIAGNOSTICS !== '1') return () => undefined;
+  const samples: number[] = [];
+  let previous = Date.now();
+  const sampleTimer = setInterval(() => {
+    const current = Date.now();
+    samples.push(Math.max(0, current - previous));
+    previous = current;
+    if (samples.length > 640) samples.shift();
+  }, 16);
+  const reportTimer = setInterval(() => {
+    if (samples.length === 0) return;
+    const sorted = [...samples].sort((a, b) => a - b);
+    const at = (percentile: number) => sorted[Math.min(sorted.length - 1, Math.floor((sorted.length - 1) * percentile))];
+    perfDiag('js-loop-histogram', {
+      sampleCount: sorted.length,
+      p50Ms: at(0.5),
+      p95Ms: at(0.95),
+      maxMs: sorted[sorted.length - 1],
+      over50Count: sorted.filter((value) => value > 50).length,
+    });
+    samples.length = 0;
+  }, 10_000);
+  return () => { clearInterval(sampleTimer); clearInterval(reportTimer); };
+}
 
