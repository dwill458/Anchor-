{
  "expo": {
    "name": "Anchor: Visual Goal Setting",
    "slug": "anchor",
    "scheme": "anchor",
    "version": "1.1.2",
    "newArchEnabled": true,
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "icon": "./assets/anchor-icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/anchor-splash-artwork.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#0F1419"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "runtimeVersion": "1.1.2",
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/8fc5bf55-b18f-41c9-a8ce-767b307debb7"
    },
    "ios": {
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "bundleIdentifier": "com.anchorintentions.app",
      "buildNumber": "14",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "NSCameraUsageDescription": "Anchor uses your camera so you can take a profile photo.",
        "NSFaceIDUsageDescription": "Anchor uses Face ID to keep your anchors secure.",
        "NSMicrophoneUsageDescription": "Anchor uses your microphone to record mantras and audio for your anchors.",
        "NSPhotoLibraryUsageDescription": "Anchor accesses your photo library so you can choose a profile photo and save exported anchor artwork.",
        "NSPhotoLibraryAddUsageDescription": "Anchor saves exported anchor wallpapers to your photo library.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          }
        ],
        "NSPrivacyCollectedDataTypes": [
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeCrashData",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypePerformanceData",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypePurchaseHistory",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeUserID",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeEmailAddress",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeOtherUserContent",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          }
        ]
      }
    },
    "android": {
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/anchor-adaptive-foreground-v2.png",
        "backgroundColor": "#260A4C",
        "monochromeImage": "./assets/anchor-monochrome.png"
      },
      "package": "com.anchorintentions.app",
      "versionCode": 34,
      "googleServicesFile": "./google-services.json",
      "edgeToEdgeEnabled": true,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.CAMERA",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      "./plugins/withFirebaseFrameworkFix",
      "@react-native-firebase/app",
      "expo-apple-authentication",
      "@sentry/react-native/expo",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/anchor-splash-artwork.jpg",
          "imageWidth": 360,
          "resizeMode": "contain",
          "backgroundColor": "#0F1419",
          "dark": {
            "image": "./assets/anchor-splash-artwork.jpg",
            "backgroundColor": "#0F1419"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "@sentry/react-native",
      "expo-audio",
      "expo-asset",
      [
        "expo-notifications",
        {
          "sounds": [
            "./src/assets/sounds/notification.wav",
            "./src/assets/sounds/notification.wav"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Anchor accesses your photo library to set your profile photo.",
          "cameraPermission": "Anchor uses your camera to set your profile photo."
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Allow Anchor to save your anchor artwork.",
          "photosPermission": "Anchor accesses your photo library so you can choose a profile photo and save exported anchor artwork.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "expo-localization",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Anchor to suggest your local priming preset when you are near a saved place."
        }
      ],
      [
        "react-native-android-widget",
        {
          "fonts": [
            "./assets/widget-fonts/Cinzel_500Medium.ttf",
            "./assets/widget-fonts/Cinzel_600SemiBold.ttf",
            "./assets/widget-fonts/CrimsonPro_600SemiBold.ttf"
          ],
          "widgets": [
            {
              "name": "AnchorSmallWidget",
              "label": "Anchor",
              "description": "Your anchor at a glance — glows gold once you prime.",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "none",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "AnchorMediumWidget",
              "label": "Anchor — Prime",
              "description": "Today's anchor with a one-tap way into your Focus session.",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "AnchorLargeWidget",
              "label": "Anchor — Session History",
              "description": "Your day thread and 18 weeks of session history.",
              "minWidth": "250dp",
              "minHeight": "250dp",
              "targetCellWidth": 4,
              "targetCellHeight": 4,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "8fc5bf55-b18f-41c9-a8ce-767b307debb7"
      }
    },
    "owner": "dwill458"
  }
}
