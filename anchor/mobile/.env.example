# ============================================================================
# Anchor App - Mobile Environment Variables
# ============================================================================
# Copy this file to .env and fill in your actual values
# Note: Expo requires public variables to be prefixed with EXPO_PUBLIC_

# ----------------------------------------------------------------------------
# Application Core
# ----------------------------------------------------------------------------

# The target environment (development, staging, production)
EXPO_PUBLIC_APP_ENV=development

# The app release version string, used for error tracking and logging
EXPO_PUBLIC_APP_RELEASE=anchor-v2@1.0.0

# Override API URL for ALL build types (dev and release APK).
# Use this to point any APK at a local backend exposed via ngrok/tunnel:
#   1. cd backend && npm run dev        (runs at http://localhost:8000)
#   2. ngrok http 8000                  (exposes it as https://xxxx.ngrok.io)
#   3. Set this to the ngrok HTTPS URL and rebuild the APK
# EXPO_PUBLIC_API_URL=https://xxxx.ngrok.io

# Dev-only backend URL (used when __DEV__=true; ignored if EXPO_PUBLIC_API_URL is set).
# For physical device: use your machine's LAN IP (e.g. http://192.168.1.x:8000)
# For Android emulator: use http://10.0.2.2:8000
EXPO_PUBLIC_DEV_API_URL=http://localhost:8000

# Legacy direct-to-Supabase anchor sync is disabled by default for v1.
# Only enable this after you have verified strict RLS on the anchors table.
EXPO_PUBLIC_ENABLE_LEGACY_SUPABASE_SYNC=false

# v1 ships with physical merch disabled.
EXPO_PUBLIC_ENABLE_MERCH=false

# Keep mock auth disabled outside isolated local UI development.
EXPO_PUBLIC_ENABLE_MOCK_AUTH=false

# Optional Firebase Auth password reset email action settings.
# The continue URL domain must be added in Firebase Console > Authentication > Settings > Authorized domains.
# Leave blank to use the Firebase project's default password reset handler.
# EXPO_PUBLIC_PASSWORD_RESET_CONTINUE_URL=https://your-domain.example/password-reset-complete
# EXPO_PUBLIC_PASSWORD_RESET_LINK_DOMAIN=auth.your-domain.example

# ----------------------------------------------------------------------------
# Developer Tools & Logging
# ----------------------------------------------------------------------------

# Enables additional developer tools in the UI
EXPO_PUBLIC_DEV_TOOLS=false

# Enables detailed debug logging console output
EXPO_PUBLIC_DEBUG_LOGGING=false

# Optional dev-only token matching backend DEV_MASTER_TOKEN for the developer
# master account bypass. Leave empty outside local development.
EXPO_PUBLIC_DEV_MASTER_TOKEN=

# ----------------------------------------------------------------------------
# Error Tracking & Monitoring (Sentry)
# ----------------------------------------------------------------------------

# Sentry Data Source Name (DSN) for error reporting. Leave empty in dev usually.
EXPO_PUBLIC_SENTRY_DSN=

# For preview / production EAS builds, set the private SENTRY_AUTH_TOKEN as an
# EAS secret rather than a public Expo env var so source maps can upload.
# The Android native build already reads SENTRY_AUTH_TOKEN, plus
# SENTRY_ORG / SENTRY_PROJECT if they are not hardcoded in sentry.properties.

# Set to true to enable Sentry error tracking in development builds
EXPO_PUBLIC_ENABLE_SENTRY_IN_DEV=false

# The sample rate for performance tracing (0.0 to 1.0)
EXPO_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.2

# The sample rate for profiling (0.0 to 1.0)
EXPO_PUBLIC_SENTRY_PROFILES_SAMPLE_RATE=0.1

# Threshold in milliseconds to distinguish slow requests in monitoring
EXPO_PUBLIC_SLOW_REQUEST_MS=2000

# ----------------------------------------------------------------------------
# Product Analytics (PostHog)
# ----------------------------------------------------------------------------
# Project API key, not a personal API key.
EXPO_PUBLIC_ANALYTICS_ENABLED=true
EXPO_PUBLIC_POSTHOG_API_KEY=phc_your_project_api_key
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ----------------------------------------------------------------------------
# RevenueCat (In-App Purchases / Subscriptions)
# ----------------------------------------------------------------------------
# Required for subscription management and paywall to function.
# Get these from: https://app.revenuecat.com -> Project -> API Keys / Entitlements

# Preferred platform-specific public SDK keys
# Local Expo dev reads `.env`, not `.env.ios`, so keep both platform keys in
# this file if you switch between Android and iOS on one machine.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=

# Temporary fallback only. Leave empty once platform-specific keys are set.
EXPO_PUBLIC_REVENUECAT_API_KEY=

# The entitlement identifier you defined in the RevenueCat dashboard
# Default is "pro" -- change if you named yours differently
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=pro

# The default package to purchase.
# Supported launch values in this repo are $rc_monthly and $rc_annual.
EXPO_PUBLIC_REVENUECAT_DEFAULT_PACKAGE_ID=$rc_monthly

# ----------------------------------------------------------------------------
# Optional Integrations
# ----------------------------------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
