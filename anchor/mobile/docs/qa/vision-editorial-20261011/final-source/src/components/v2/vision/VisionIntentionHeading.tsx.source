import { useEffect, useMemo, useRef, useState } from 'react';
import { StyleSheet, Text, View, type NativeSyntheticEvent, type TextLayoutEventData } from 'react-native';
import { categoryLabel } from '@/components/v2/anchors/anchorPresentation';
import { colors, getCategoryColor, typography } from '@/theme/v2';

function wordsOf(text: string) {
  return text.trim().split(/\s+/).filter(Boolean);
}

function estimatedWordWidth(word: string, fontSize: number) {
  let em = 0;
  for (const character of word) {
    if ('ilI.,:;!|\''.includes(character)) em += 0.27;
    else if ('mwMW@%&'.includes(character)) em += 0.82;
    else if (/[A-Z0-9]/.test(character)) em += 0.61;
    else em += 0.49;
  }
  return em * fontSize;
}

/** Choose the fewest lines that fit, then minimize raggedness using native word widths. */
export function balanceIntentionLines(text: string, maxWidth: number, wordWidths: readonly number[], spaceWidth: number) {
  const words = wordsOf(text);
  if (!words.length) return '';
  const widthOf = (start: number, end: number) => wordWidths.slice(start, end).reduce((sum, width) => sum + width, 0) + Math.max(0, end - start - 1) * spaceWidth;

  for (let lineCount = 1; lineCount <= words.length; lineCount += 1) {
    const memo = new Map<string, { cost: number; lines: string[] } | null>();
    const solve = (start: number, remaining: number): { cost: number; lines: string[] } | null => {
      const key = `${start}:${remaining}`;
      if (memo.has(key)) return memo.get(key) ?? null;
      if (remaining === 1) {
        const lineWidth = widthOf(start, words.length);
        if (lineWidth > maxWidth && words.length - start > 1) { memo.set(key, null); return null; }
        const result = { cost: (maxWidth - lineWidth) ** 2, lines: [words.slice(start).join(' ')] };
        memo.set(key, result);
        return result;
      }
      let best: { cost: number; lines: string[] } | null = null;
      const lastEnd = words.length - remaining + 1;
      for (let end = start + 1; end <= lastEnd; end += 1) {
        const lineWidth = widthOf(start, end);
        if (lineWidth > maxWidth && end - start > 1) break;
        const tail = solve(end, remaining - 1);
        if (!tail) continue;
        const leadingJoiner = /^(of|and|or|to|for|with|in|on|at|by|from|the|a|an)$/i.test(words[end] ?? '');
        const candidate = { cost: (maxWidth - lineWidth) ** 2 + tail.cost + (leadingJoiner ? maxWidth ** 2 : 0), lines: [words.slice(start, end).join(' '), ...tail.lines] };
        if (!best || candidate.cost < best.cost) best = candidate;
      }
      memo.set(key, best);
      return best;
    };
    const balanced = solve(0, lineCount);
    if (balanced) return balanced.lines.join('\n');
  }
  return words.join('\n');
}

export function estimateIntentionLineCount(text: string, width: number, fontSize: number) {
  const words = wordsOf(text);
  if (!words.length) return 1;
  const estimatedWidths = words.map(word => estimatedWordWidth(word, fontSize));
  const normalLines = balanceIntentionLines(text, width, estimatedWidths, fontSize * 0.25).split('\n').length;
  const nativeWrappedLines = Math.max(1, ...estimatedWidths.map(wordWidth => Math.ceil(wordWidth / Math.max(1, width))));
  return Math.max(normalLines, nativeWrappedLines);
}

export function visionIntentionFontSize(text: string) {
  return text.length > 100 ? 22 : text.length > 60 ? 26 : 36;
}

/** A quiet editorial introduction to the board, with the complete real intention. */
export function VisionIntentionHeading({
  intention,
  category,
  onMeasured,
}: {
  intention: string;
  category?: string | null;
  onMeasured?: (textHeight: number) => void;
}) {
  const words = useMemo(() => wordsOf(intention), [intention]);
  const [availableWidth, setAvailableWidth] = useState(0);
  const fontSize = visionIntentionFontSize(intention);
  const [measurements, setMeasurements] = useState<Record<string, number>>({});
  const measuredCallback = useRef(onMeasured);
  measuredCallback.current = onMeasured;
  const displayedHeight = useRef(0);
  const displayedLayoutSignature = useRef('');
  const signature = `${fontSize}:${intention}:${availableWidth}`;
  const reported = useRef('');

  const handleTextLayout = (key: string, event: NativeSyntheticEvent<TextLayoutEventData>) => {
    const width = event.nativeEvent.lines[0]?.width;
    if (!width || !Number.isFinite(width)) return;
    const storageKey = `${key}:${fontSize}`;
    setMeasurements(current => Math.abs((current[storageKey] ?? 0) - width) < 0.5 ? current : { ...current, [storageKey]: width });
  };

  const wordKeys = words.map((word, index) => `${index}:${word}`);
  const measuredWidths = words.map((word, index) => measurements[`${wordKeys[index]}:${fontSize}`] ?? estimatedWordWidth(word, fontSize));
  const pairWidth = measurements[`measure:M M:${fontSize}`] ?? 0;
  const joinedWidth = measurements[`measure:MM:${fontSize}`] ?? 0;
  const nativeSpaceWidth = pairWidth - joinedWidth;
  const spaceWidth = nativeSpaceWidth > 0 ? nativeSpaceWidth : fontSize * 0.25;
  const balanced = useMemo(() => balanceIntentionLines(intention, availableWidth || 10000, measuredWidths, spaceWidth),
    [availableWidth, intention, measuredWidths.join(','), spaceWidth]);

  useEffect(() => {
    const wordsMeasured = words.every((word, index) => word.length > 40 || measurements[`${wordKeys[index]}:${fontSize}`] != null);
    const spaceMeasured = words.length < 2 || nativeSpaceWidth > 0;
    if (availableWidth <= 0 || !wordsMeasured || !spaceMeasured || reported.current === signature) return;
    reported.current = signature;
    requestAnimationFrame(() => requestAnimationFrame(() => {
      if (!words.length) measuredCallback.current?.(0);
      else if (displayedLayoutSignature.current === signature && displayedHeight.current > 0) measuredCallback.current?.(displayedHeight.current);
    }));
  }, [availableWidth, fontSize, measurements, nativeSpaceWidth, signature, wordKeys.join('|'), words]);

  const measureWord = (key: string) => (event: NativeSyntheticEvent<TextLayoutEventData>) => handleTextLayout(key, event);
  return <View testID="vision-intention-heading" style={styles.heading} onLayout={event => {
    const nextWidth = event.nativeEvent.layout.width;
    setAvailableWidth(current => Math.abs(current - nextWidth) < 0.5 ? current : nextWidth);
  }}>
    <View style={styles.categoryRow}>
      <View style={[styles.dot, { backgroundColor: getCategoryColor(category) }]} />
      <Text style={styles.category}>{categoryLabel(category).toUpperCase()}</Text>
    </View>
    <Text accessibilityRole="header" onTextLayout={event => {
      displayedHeight.current = event.nativeEvent.lines.length * (fontSize + 5);
      displayedLayoutSignature.current = signature;
    }} onLayout={event => {
      displayedHeight.current = event.nativeEvent.layout.height;
      displayedLayoutSignature.current = signature;
    }} style={[styles.intention, { fontSize, lineHeight: fontSize + 5 }]}>{balanced}</Text>
    <View pointerEvents="none" accessible={false} importantForAccessibility="no-hide-descendants" style={styles.measurementBank}>
      {words.map((word, index) => {
        const key = wordKeys[index];
        return word.length > 40 ? null : <Text key={key} onTextLayout={measureWord(key)} style={[styles.measurementText, { fontSize }]}>{word}</Text>;
      })}
      {words.length > 1 ? <>
        <Text onTextLayout={measureWord('measure:MM')} style={[styles.measurementText, { fontSize }]}>MM</Text>
        <Text onTextLayout={measureWord('measure:M M')} style={[styles.measurementText, { fontSize }]}>M M</Text>
      </> : null}
    </View>
  </View>;
}

const styles = StyleSheet.create({
  heading: { alignItems: 'center', paddingBottom: 4, gap: 6, width: '100%' },
  categoryRow: { flexDirection: 'row', alignItems: 'center', gap: 7 },
  dot: { width: 5, height: 5, borderRadius: 3 },
  category: { ...typography.labelSM, fontSize: 10, letterSpacing: 1.5, color: colors.text.secondary },
  intention: { fontFamily: 'EBGaramond-Regular', letterSpacing: -0.4, color: colors.text.primary, textAlign: 'center', width: '100%' },
  measurementBank: { position: 'absolute', left: -1000, top: 0, opacity: 0, width: 700 },
  measurementText: { position: 'absolute', left: 0, top: 0, fontFamily: 'EBGaramond-Regular', letterSpacing: -0.4, includeFontPadding: false, width: 700 },
});
