/** Editorial canvas geometry shared by overview, gestures and the protected cinematic camera. */
/** The most images a Vision holds; the board has a composition for each count up to this. */
export const VISION_BOARD_MAX_IMAGES = 8;
/** A finished board holds at least this many; fewer is a partial board (creation, uploads in flight). */
export const VISION_BOARD_TARGET_MIN_IMAGES = 3;

/** Board width / height for a finished (2+ photo) board: the approved mockup's footprint. */
export const VISION_BOARD_ASPECT = 1 / 1.56;
/** Selection, generation and the dominant Canvas aperture use the same centre crop. */
export const VISION_HERO_ASPECT = 1.36;

export type BoardFrameKind = 'landscape' | 'portrait' | 'square';
export const BOARD_FRAME_KINDS: readonly BoardFrameKind[] = ['landscape', 'portrait', 'square'];

export const BOARD_FRAME_ASPECT: Record<BoardFrameKind, number> = {
  landscape: 1.56,
  portrait: 0.92,
  square: 1.2,
};

/** Where the photograph shows through each photograph, as fractions of the frame. */
export const BOARD_FRAME_WINDOW: Record<BoardFrameKind, { left: number; top: number; right: number; bottom: number }> = {
  landscape: { left: 0, top: 0, right: 1, bottom: 1 },
  portrait: { left: 0, top: 0, right: 1, bottom: 1 },
  square: { left: 0, top: 0, right: 1, bottom: 1 },
};

export const BOARD_CARD_ASPECT = 1;
/** Approximately 30% larger than the previous 0.94 × card-width medallion. */
export const VISION_SEAL_DIAMETER_SCALE = 1.22;

export type BoardSlot = {
  x: number;
  y: number;
  width: number;
  aspectRatio: number;
  rotation: number;
  zIndex: number;
  frame: BoardFrameKind;
};

export type BoardCardSlot = Omit<BoardSlot, 'frame'>;

export type BoardLayout = {
  /** How many photos this composition holds. */
  count: number;
  photos: BoardSlot[];
  card: BoardCardSlot;
  /** No decorative physical materials. */
  decor: [];
};

// Compatibility names retain the proven camera/gesture contract. No physical board is rendered.
function photo(frame: BoardFrameKind, x: number, y: number, width: number, aspectRatio: number, zIndex = 12, rotation = 0): BoardSlot {
  return { frame, x, y, width, aspectRatio, rotation, zIndex };
}
function seal(y: number, x = 0.49): BoardCardSlot {
  return { x, y, width: 0.24, aspectRatio: 1, rotation: 0, zIndex: 40 };
}
const LAYOUTS: readonly BoardLayout[] = [
  { count: 0, photos: [], card: seal(0.5), decor: [] },
  { count: 1, photos: [photo('portrait', 0.5, 0.445, 1, 0.9)], card: seal(0.78, 0.73), decor: [] },
  { count: 2, photos: [photo('landscape', 0.5, 0.2355, 1, VISION_HERO_ASPECT),
    photo('square', 0.64, 0.695, 0.72, 1.04)], card: seal(0.47, 0.40), decor: [] },
  { count: 3, photos: [photo('landscape', 0.5, 0.2355, 1, VISION_HERO_ASPECT),
    photo('portrait', 0.235, 0.679, 0.45, 0.76), photo('square', 0.755, 0.697, 0.48, 0.8, 13)], card: seal(0.47), decor: [] },
];

function boundedAspect(sourceAspect: number | undefined, fallback: number, min = 0.48, max = 1.82): number {
  return Number.isFinite(sourceAspect) && sourceAspect! > 0
    ? Math.max(min, Math.min(max, sourceAspect!))
    : fallback;
}

function frameForAspect(aspect: number): BoardFrameKind {
  return aspect < 0.88 ? 'portrait' : aspect > 1.32 ? 'landscape' : 'square';
}

function detailPhoto(index: number, x: number, physicalY: number, width: number, fallbackAspect: number,
  sceneScale: number, sourceAspects: readonly number[], zIndex: number, rotation: number): BoardSlot {
  const aspectRatio = boundedAspect(sourceAspects[index], fallbackAspect);
  return photo(frameForAspect(aspectRatio), x, physicalY / sceneScale, width, aspectRatio, zIndex, rotation);
}

function seamCenter(a: BoardSlot, b: BoardSlot, sceneScale: number): number {
  const aHeight = a.width / a.aspectRatio;
  const bHeight = b.width / b.aspectRatio;
  const aCenter = a.y * sceneScale;
  const bCenter = b.y * sceneScale;
  const top = Math.max(aCenter - aHeight / 2, bCenter - bHeight / 2);
  const bottom = Math.min(aCenter + aHeight / 2, bCenter + bHeight / 2);
  return bottom > top ? (top + bottom) / 2 : (aCenter + aHeight / 2 + bCenter - bHeight / 2) / 2;
}

function detailSupports(count: number, sourceAspects: readonly number[], sceneScale: number, heroBottom: number): BoardSlot[] {
  const remaining = count - 1;
  if (remaining <= 0) return [];
  if (count === 3 && sourceAspects[1] >= 1.3 && sourceAspects[2] >= 1.3) {
    // Wide supports stagger to retain presence while keeping their centres clear.
    const firstAspect = boundedAspect(sourceAspects[1], 1.5);
    const secondAspect = boundedAspect(sourceAspects[2], 1.5);
    const firstTop = heroBottom - .045;
    const firstHeight = .67 / firstAspect;
    const secondTop = firstTop + firstHeight - .11;
    return [
      detailPhoto(1, .36, firstTop + firstHeight / 2, .67, firstAspect, sceneScale, sourceAspects, 13, -3.2),
      detailPhoto(2, .65, secondTop + .64 / secondAspect / 2, .64, secondAspect, sceneScale, sourceAspects, 14, 2.3),
    ];
  }
  const rows: Array<{ indices: number[]; width: number; centers: number[] }> = count <= 4
    ? [{ indices: Array.from({ length: remaining }, (_, i) => i + 1), width: remaining === 1 ? .58 : remaining === 2 ? .46 : .31,
      centers: remaining === 3 ? [.18, .50, .82] : remaining === 2 ? [.28, .72] : [.50] }]
    : count === 5
      ? [{ indices: [1, 2], width: .40, centers: [.28, .72] }, { indices: [3, 4], width: .40, centers: [.28, .72] }]
      : count === 6
        ? [{ indices: [1, 2, 3], width: .31, centers: [.18, .50, .82] }, { indices: [4, 5], width: .40, centers: [.28, .72] }]
      : count === 7
        ? [{ indices: [1, 2], width: .40, centers: [.28, .72] }, { indices: [3, 4], width: .40, centers: [.28, .72] },
          { indices: [5, 6], width: .40, centers: [.28, .72] }]
        : [{ indices: [1, 2, 3], width: .31, centers: [.18, .50, .82] }, { indices: [4, 5], width: .40, centers: [.28, .72] },
          { indices: [6, 7], width: .40, centers: [.28, .72] }];
  let rowTop = heroBottom - .045;
  const result: BoardSlot[] = [];
  rows.forEach((row, rowIndex) => {
    const items = row.indices.map(index => {
      const aspect = boundedAspect(sourceAspects[index], row.centers.length === 3 ? 1.18 : 1.0);
      const width = Math.min(row.width, aspect * .46);
      return { index, aspect, width, height: width / aspect };
    });
    const rowHeight = Math.max(...items.map(item => item.height));
    items.forEach((item, column) => result.push(detailPhoto(item.index, row.centers[column], rowTop + item.height / 2 + (count === 3 ? column * .025 : column % 2 * .012),
      item.width, row.centers.length === 3 ? 1.18 : 1.0, sceneScale, sourceAspects,
      13 + rowIndex * 3 + column, count === 3 ? (column === 0 ? -3.2 : 2.3) : [-2.4, 2.1, -1.2, 2.7, -2, 1.6, -2.6][item.index % 7])));
    rowTop += rowHeight * .90;
  });
  return result;
}

/** The composition for a number of photos; never more than the board's maximum. */
export function selectBoardLayout(imageCount: number): BoardLayout {
  const count = Math.max(0, Math.min(VISION_BOARD_MAX_IMAGES, Math.floor(Number.isFinite(imageCount) ? imageCount : 0)));
  return LAYOUTS[Math.min(count, 3)];
}

/** Detail-only composition. Visualize retains its established camera apertures. */
export function selectDetailBoardLayout(imageCount: number, sourceAspects: readonly number[] = [], requestedSceneScale?: number): BoardLayout {
  const count = Math.max(0, Math.min(VISION_BOARD_MAX_IMAGES,
    Math.floor(Number.isFinite(imageCount) ? imageCount : 0)));
  if (count === 0) return selectBoardLayout(0);
  const sceneScale = requestedSceneScale ?? detailSceneScale(count, sourceAspects);
  const heroAspect = boundedAspect(sourceAspects[0], VISION_HERO_ASPECT);
  const heroWidth = Math.min(.96, heroAspect * .82);
  const heroHeight = heroWidth / heroAspect;
  const heroBottom = .035 + heroHeight;
  const hero = detailPhoto(0, .5, .035 + heroHeight / 2, heroWidth, heroAspect, sceneScale, sourceAspects, 12, -.8);
  const photos = [hero, ...detailSupports(count, sourceAspects, sceneScale, heroBottom)];
  const sealPhysicalY = count === 1 ? heroBottom - .13 : .82;
  const card = seal(sealPhysicalY / sceneScale, .5);
  if (count === 1) return { count, decor: [], card: { ...card, x: .5 + heroWidth * .24, y: sealPhysicalY / sceneScale, width: .24 }, photos };
  if (count === 2) {
    const aspect = boundedAspect(sourceAspects[1], 1.04);
    const width = Math.min(.64, aspect * .62);
    const second = detailPhoto(1, .63, heroBottom - .055 + width / aspect / 2, width, 1.04, sceneScale, sourceAspects, 13, 2.4);
    return { count, decor: [], card: { ...card, x: .5, y: seamCenter(hero, second, sceneScale) / sceneScale }, photos: [hero, second] };
  }
  if (count === 3) {
    const supports = photos.slice(1);
    const seam = Math.min(...supports.map(support => seamCenter(hero, support, sceneScale)));
    return { count, decor: [], card: { ...card, x: .5, y: seam / sceneScale }, photos: [
      hero,
      ...supports,
    ] };
  }
  const firstSupport = photos[1];
  const seam = firstSupport ? seamCenter(hero, firstSupport, sceneScale) : sealPhysicalY;
  // A three-print row has a photograph at the centre. Sign the seam between
  // columns so the enlarged seal does not cover that supporting subject.
  const sealX = count === 4 || count === 6 || count === 8 ? .34 : .5;
  return { count, decor: [], card: { ...card, x: sealX, y: seam / sceneScale }, photos };
}

export function detailBoardSizeForWidth(width: number, count: number, sourceAspects: readonly number[] = []): Size {
  return { width, height: width * detailSceneScale(count, sourceAspects) };
}

function detailSceneScale(count: number, sourceAspects: readonly number[] = []): number {
  const layout = selectDetailBoardLayout(count, sourceAspects, 1);
  if (!layout.photos.length) return .45;
  const photoBottom = Math.max(...layout.photos.map(slot => slot.y + slot.width / slot.aspectRatio / 2));
  const cardBottom = layout.card.y + layout.card.width / 2;
  return Math.max(0.65, photoBottom, cardBottom) + .12;
}

/** The slots offered as "add an image" placeholders on an empty board. */
export function emptyBoardPlaceholderSlots(): BoardSlot[] {
  return [];
}

export type Size = { width: number; height: number };

/** A resolved object on a rendered board: top-left position and size in scene pixels. */
export type SceneRect = { x: number; y: number; width: number; height: number; rotation: number; zIndex: number };

/** Resolves a normalised slot to scene pixels for a board of `scene` size. */
export function toSceneRect(slot: Pick<BoardSlot, 'x' | 'y' | 'width' | 'aspectRatio' | 'rotation' | 'zIndex'>, scene: Size): SceneRect {
  const width = slot.width * scene.width;
  const height = width / slot.aspectRatio;
  return {
    x: slot.x * scene.width - width / 2,
    y: slot.y * scene.height - height / 2,
    width,
    height,
    rotation: slot.rotation,
    zIndex: slot.zIndex,
  };
}

/** The board's rendered size for a given width. */
export function boardSizeForWidth(width: number, imageCount = 3): Size {
  return { width, height: width / (imageCount === 0 ? 1 / 0.45 : imageCount === 1 ? 1 / 1.25 : VISION_BOARD_ASPECT) };
}
