import { render, fireEvent } from '@testing-library/react-native';
import { StyleSheet, Text } from 'react-native';
import { VisionEditorialPreview } from '../VisionEditorialPreview';
import { VisionBoardPreview } from '../VisionBoardPreview';

jest.mock('@/hooks/v2', () => ({ useV2ReduceMotion: () => true }));
const photos = Array.from({ length: 26 }, (_, i) => ({ id: `photo-${i}`, imageUrl: `https://vision.test/${i}.jpg` }));

describe('VisionEditorialPreview', () => {
  it.each(['home', 'details'] as const)('%s renders every photograph, including boards beyond 24 images', variant => {
    for (const count of [1, 2, 3, 4, 6, 8, 20, 26]) {
      const view = render(<VisionEditorialPreview tiles={photos.slice(0, count)} variant={variant} testID="preview" />);
      for (let i = 0; i < count; i++) expect(view.getByTestId(`preview-image-${i}`)).toBeTruthy();
      expect(view.queryByTestId('preview-overflow')).toBeNull();
      view.unmount();
    }
    const large = render(<VisionEditorialPreview tiles={photos} variant={variant} testID="preview" />);
    for (let i = 0; i < photos.length; i++) expect(large.getByTestId(`preview-image-${i}`)).toBeTruthy();
    expect(large.queryByTestId('preview-overflow')).toBeNull();
    expect(large.getByText('26 images')).toBeTruthy();
    expect(large.getByRole('button').props.accessibilityLabel).toBe('View Vision');
  });

  it('details represents all six real images and respects the featured image', () => {
    const view = render(<VisionEditorialPreview tiles={photos.slice(0, 6)} variant="details" featuredTileId="photo-2" imageTestID="hero" testID="preview" />);
    expect(view.getByTestId('hero').props.source.uri).toBe(photos[2].imageUrl);
    [0, 1, 3, 4, 5].forEach(i => expect(view.getByTestId(`preview-image-${i}`)).toBeTruthy());
    expect(view.queryByTestId('preview-image-6')).toBeNull();
  });

  it('contains extreme source aspect ratios and repacks known ratios inside the measured stage', () => {
    const view = render(<VisionEditorialPreview tiles={photos.slice(0, 3)} variant="details" testID="preview" />);
    const image = view.getByTestId('preview-image-0');
    expect(image.props.resizeMode).toBe('contain');
    for (const source of [{ width: 300, height: 1200 }, { width: 1600, height: 300 }]) {
      fireEvent(image, 'load', { nativeEvent: { source } });
      const print = StyleSheet.flatten(view.getByTestId('preview-image-0-print').props.style);
      expect((print.width - 8) / (print.height - 11)).toBeCloseTo(source.width / source.height, 5);
    }
    const slot = view.getByTestId('preview-photo-slot-0');
    const before = StyleSheet.flatten(slot.props.style);
    fireEvent(view.getByTestId('preview-image-0'), 'load', { nativeEvent: { source: { width: 300, height: 1200 } } });
    const after = StyleSheet.flatten(view.getByTestId('preview-photo-slot-0').props.style);
    expect(after.width).toBeLessThan(before.width);
    // The shared board bounds the aperture, while contain preserves the original.
    expect(after.width / after.height).toBeCloseTo(0.48, 2);
  });

  it('renders the real note material on a note-only board', () => {
    const renderNote = jest.fn(() => <Text>Private note copy</Text>);
    const view = render(<VisionEditorialPreview tiles={[]} noteElements={[{ id: 'real-note', render: renderNote }]} testID="preview" />);
    expect(view.getByText('Private note copy')).toBeTruthy();
    expect(renderNote).toHaveBeenCalled();
    expect(view.queryByText('Your Vision has no images yet')).toBeNull();
  });

  it('layers saved material on Details while retaining every photograph', () => {
    const renderNote = jest.fn(() => <Text>Hidden note text</Text>);
    const notes = [0, 1, 2].map(i => ({ id: `note-${i}`, render: renderNote }));
    const view = render(<VisionEditorialPreview tiles={photos.slice(0, 6)} variant="details" noteElements={notes} />);
    expect(view.getAllByText('Hidden note text')).toHaveLength(2);
    expect(renderNote).toHaveBeenCalledTimes(2);
    expect([0, 1, 2, 3, 4, 5].every(index => view.getByTestId(`vision-editorial-preview-image-${index}`))).toBe(true);
  });

  it('reuses decoded URLs after signing refresh and falls through to a fresh URL after failure', () => {
    const original = 'https://vision.test/photo.jpg?X-Amz-Signature=old';
    const refreshed = 'https://vision.test/photo.jpg?X-Amz-Signature=new';
    const view = render(<VisionEditorialPreview tiles={[{ id: 'signed', imageUrl: original }]} testID="preview" />);
    view.rerender(<VisionEditorialPreview tiles={[{ id: 'signed', imageUrl: refreshed }]} testID="preview" />);
    expect(view.getByTestId('preview-image-0').props.source.uri).toBe(original);
    fireEvent(view.getByTestId('preview-image-0'), 'error', {});
    expect(view.getByTestId('preview-image-0').props.source.uri).toBe(refreshed);
  });

  it('recovers when an unavailable image URI changes and preserves navigation during failure', () => {
    const open = jest.fn();
    const view = render(<VisionBoardPreview tiles={photos} testID="preview" onPress={open} />);
    fireEvent(view.getByTestId('preview-image-0'), 'error', {});
    expect(view.getByText('Image unavailable')).toBeTruthy();
    expect(view.getByTestId('preview-image-1')).toBeTruthy();
    fireEvent.press(view.getByTestId('preview'));
    expect(open).toHaveBeenCalledTimes(1);
    view.rerender(<VisionBoardPreview tiles={[{ ...photos[0], imageUrl: photos[1].imageUrl }]} testID="preview" />);
    expect(view.getByTestId('preview-image-0').props.source.uri).toBe(photos[1].imageUrl);
  });

  it('exposes a labeled navigation target and respects reduced motion', () => {
    const open = jest.fn();
    const view = render(<VisionEditorialPreview tiles={photos} onPress={open} accessibilityLabel="View my Vision" reduceMotion testID="preview" />);
    expect(view.getByRole('button', { name: 'View my Vision' })).toBeTruthy();
    fireEvent.press(view.getByTestId('preview'));
    expect(open).toHaveBeenCalledTimes(1);
    expect(view.getByTestId('preview-image-0').props.fadeDuration).toBe(0);
    expect(view.UNSAFE_root.findAll((node: { props: { entering?: unknown } }) => node.props.entering !== undefined)).toHaveLength(0);
  });
});
