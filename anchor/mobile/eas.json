{
  "$schema": "https://json.expo.io/eas.schema.json",
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "development",
        "EXPO_PUBLIC_DEBUG_LOGGING": "true",
        "EXPO_PUBLIC_ENABLE_LEGACY_SUPABASE_SYNC": "false",
        "EXPO_PUBLIC_ENABLE_MERCH": "false",
        "EXPO_PUBLIC_ENABLE_GOOGLE_SIGN_IN": "true",
        "EXPO_PUBLIC_ENABLE_MOCK_AUTH": "false",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      },
      "android": {},
      "ios": {
        "simulator": false,
        "prebuildCommand": "npx expo prebuild --platform ios --no-install"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "staging",
        "EXPO_PUBLIC_DEBUG_LOGGING": "false",
        "EXPO_PUBLIC_ENABLE_LEGACY_SUPABASE_SYNC": "false",
        "EXPO_PUBLIC_ENABLE_MERCH": "false",
        "EXPO_PUBLIC_ENABLE_GOOGLE_SIGN_IN": "true",
        "EXPO_PUBLIC_ENABLE_MOCK_AUTH": "false",
        "SENTRY_DISABLE_AUTO_UPLOAD": "false"
      },
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "prebuildCommand": "npx expo prebuild --platform ios --no-install"
      }
    },
    "playstore": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "production",
        "EXPO_PUBLIC_DEBUG_LOGGING": "false",
        "EXPO_PUBLIC_ENABLE_LEGACY_SUPABASE_SYNC": "false",
        "EXPO_PUBLIC_ENABLE_MERCH": "false",
        "EXPO_PUBLIC_ENABLE_GOOGLE_SIGN_IN": "true",
        "EXPO_PUBLIC_ENABLE_MOCK_AUTH": "false",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      },
      "android": {
        "buildType": "app-bundle",
        "autoIncrement": true
      }
    },
    "production": {
      "distribution": "store",
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "production",
        "EXPO_PUBLIC_DEBUG_LOGGING": "false",
        "EXPO_PUBLIC_ENABLE_LEGACY_SUPABASE_SYNC": "false",
        "EXPO_PUBLIC_ENABLE_MERCH": "false",
        "EXPO_PUBLIC_ENABLE_GOOGLE_SIGN_IN": "true",
        "EXPO_PUBLIC_ENABLE_MOCK_AUTH": "false",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      },
      "android": {
        "buildType": "app-bundle",
        "autoIncrement": true
      },
      "ios": {
        "autoIncrement": true,
        "prebuildCommand": "npx expo prebuild --platform ios --no-install"
      }
    }
  },
  "submit": {
      "production": {
        "ios": {
          "appleId": "deontrezwilliams@gmail.com",
          "ascAppId": "6767420385",
          "appleTeamId": "GZAHS664L8"
        },
        "android": {
          "serviceAccountKeyPath": "./google-service-account.json",
          "track": "internal"
      }
    }
  }
}
