# ============================================================================
# Anchor App - Backend Environment Variables
# ============================================================================
# Copy this file to .env and fill in your actual values

# ----------------------------------------------------------------------------
# Database
# ----------------------------------------------------------------------------
# connection_limit: max connections per Prisma instance (default is 5 * CPU cores, often too low)
# pool_timeout: seconds to wait for a free connection before erroring (default 10)
DATABASE_URL="postgresql://user:password@localhost:5432/anchor_db?schema=public&connection_limit=20&pool_timeout=20"
REDIS_URL="redis://localhost:6379"

# ----------------------------------------------------------------------------
# Server Configuration
# ----------------------------------------------------------------------------
PORT=3000
NODE_ENV="development"
ALLOWED_ORIGINS="http://localhost:8081,http://localhost:3000"

# ----------------------------------------------------------------------------
# Authentication & Security
# ----------------------------------------------------------------------------
JWT_SECRET="your-secret-key-here-change-this-in-production"
JWT_EXPIRES_IN="7d"
DEV_MASTER_TOKEN=""
COMPED_ACCESS_EMAILS=""

# Set to "true" only if you intentionally want to bypass Firebase auth with
# the mobile mock AuthService during local development. Keep this "false" when
# testing real Firebase sign-in.
ENABLE_MOCK_AUTH="false"

# Required when ENABLE_MOCK_AUTH="true": the Bearer token value accepted as a
# valid mock credential. Use a long random string — never use a simple value
# like "mock-jwt-token". Generate one with: openssl rand -hex 32
MOCK_AUTH_TOKEN=""

# ----------------------------------------------------------------------------
# Firebase Admin Configuration
# Get these from Firebase Console:
# Project settings -> Service accounts -> Firebase Admin SDK -> Generate new private key
# Download the JSON, then map:
#   FIREBASE_PROJECT_ID  <- project_id
#   FIREBASE_CLIENT_EMAIL <- client_email
#   FIREBASE_PRIVATE_KEY <- private_key
#
# IMPORTANT:
# - Keep the service account JSON on the backend only. Never put it in the mobile app.
# - Replace actual line breaks in private_key with literal \n sequences when pasting into .env.
# ----------------------------------------------------------------------------
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL="your-client-email"

# ----------------------------------------------------------------------------
# AI & Image Generation
# ----------------------------------------------------------------------------
# Gemini 3 Pro Image (Primary) - Nano Banana Pro
# Get your API key from: https://aistudio.google.com/apikey
GEMINI_API_KEY="your-gemini-api-key-here"

# Quality Tier (optional)
# Options: 'premium' (gemini-3-pro-image-preview, highest fidelity, $0.02/image)
#          'draft' (gemini-3-flash-preview, faster/cheaper, $0.005/image)
# Default: 'premium'
GEMINI_TIER="premium"

# Replicate API (Fallback) - Stable Diffusion ControlNet
REPLICATE_API_TOKEN="your-replicate-token"

# AI Provider Selection (optional)
# Options: 'gemini' (primary), 'replicate' (fallback only), 'auto' (default - tries Gemini first)
AI_PROVIDER="auto"
AI_DAILY_LIMIT="20"

# ----------------------------------------------------------------------------
# Storage (Cloudflare R2 - S3 Compatible)
# ----------------------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID="your-cloudflare-account-id"
CLOUDFLARE_R2_ACCESS_KEY_ID="your-access-key"
CLOUDFLARE_R2_SECRET_ACCESS_KEY="your-secret-key"
CLOUDFLARE_R2_BUCKET_NAME="anchor-assets"
CLOUDFLARE_R2_PUBLIC_DOMAIN="https://your-public-domain.com"
LOCAL_IP="127.0.0.1"

# ----------------------------------------------------------------------------
# E-commerce (Printful)
# ----------------------------------------------------------------------------
PRINTFUL_API_KEY="your-printful-key"
PRINTFUL_WEBHOOK_SECRET="your-webhook-secret"
PRINTFUL_STORE_ID=""
PRINTFUL_CREATE_ORDERS="false"
PRINTFUL_CONFIRM_ORDERS="false"
PRINTFUL_VARIANT_IDS='{"print:16x20:black":20262,"phone-case:iphone-16:clear":20348,"desk-mat:12x18:black":22325}'
PRINTFUL_MOCKUP_TEMPLATE_IDS='{"print":795,"phone-case:iphone-16":181,"phone-case:samsung-galaxy-s25":267,"desk-mat":853}'

# ----------------------------------------------------------------------------
# Subscriptions (RevenueCat)
# ----------------------------------------------------------------------------
REVENUECAT_API_KEY="your-revenuecat-key"

# ----------------------------------------------------------------------------
# Feature Flags
# ----------------------------------------------------------------------------
# v1 ships with merch disabled.
ENABLE_MERCH="false"
# Gates the Visualize practice mode. When false, all three
# /api/anchors/:id/visualization-scene* endpoints return 403 FEATURE_DISABLED
# and the client silently falls back to deterministic scenes.
ENABLE_VISUALIZE="false"

# ----------------------------------------------------------------------------
# Google Text-to-Speech
# ----------------------------------------------------------------------------
GOOGLE_TTS_API_KEY="your-google-tts-key"
# Generative Language API key. Canonical name — used for Visualize scene
# generation. GEMINI_API_KEY is accepted as an alias when this is unset;
# see resolveGoogleApiKey() in src/config/env.ts. Set exactly one.
GOOGLE_API_KEY="your-google-api-key"
# GEMINI_API_KEY="alias-for-GOOGLE_API_KEY"
GOOGLE_SCENE_MODEL="gemini-2.0-flash"
# Provider timeout for scene generation. Defaults to 15000 when unset.
VISUALIZE_SCENE_TIMEOUT_MS="15000"
GOOGLE_CLOUD_PROJECT_ID="your-google-cloud-project-id"
GOOGLE_CLOUD_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_GOOGLE_CLOUD_KEY_HERE\n-----END PRIVATE KEY-----\n"
GOOGLE_CLOUD_CLIENT_EMAIL="your-google-cloud-client-email"

# ----------------------------------------------------------------------------
# Optional - Analytics & Monitoring
# ----------------------------------------------------------------------------
SENTRY_DSN=""
POSTHOG_API_KEY=""
POSTHOG_HOST="https://us.i.posthog.com"
SEGMENT_WRITE_KEY=""
